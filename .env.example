# PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/autosite

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel server-side credentials
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Storage provider: local | vercel-blob | s3 | r2 | azure
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=.local-storage

# Email provider
EMAIL_FROM=
EMAIL_API_KEY=

# Internal worker authentication
WORKER_SECRET=
MAX_GENERATION_ATTEMPTS=3
